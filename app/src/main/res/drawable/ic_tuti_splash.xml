<?xml version="1.0" encoding="utf-8"?>
<!--
  Иконка системного сплэша. Те же пути, что в design/mascot и в ui/mascot,
  но поза симметричная с опущенными крыльями: круглая маска Android 12+
  срезала бы поднятое крыло.

  Холст 288x288 по гайдлайну сплэша. Группа вписывает рисунок (координаты
  0..100, границы 17..83 по X и 9..88.5 по Y) по центру холста.

  Масштаб 2.35 даёт высоту рисунка ~187dp. Это вписывается и в безопасные
  192dp иконки без подложки, и в 160dp внутри круга-медальона, который
  задаёт windowSplashScreenIconBackgroundColor: при 1.95 маскот тонул в
  белом круге, оставляя широкие поля.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288">

    <group
        android:scaleX="2.35"
        android:scaleY="2.35"
        android:translateX="26.5"
        android:translateY="29.4">

        <!-- crest -->
        <path
            android:fillColor="#00A374"
            android:pathData="M36.5,14.5 c5,2.5 9,8 11,15 c-1,2.5 -5.5,2.5 -7.5,0 c-4,-5.5 -6.5,-11.5 -3.5,-15 z" />
        <path
            android:fillColor="#00A374"
            android:pathData="M50,9 c5,4.5 6.5,11 4,20 c-1.5,2.5 -6.5,2.5 -8,0 c-2.5,-9 -1,-15.5 4,-20 z" />
        <path
            android:fillColor="#00A374"
            android:pathData="M63.5,14.5 c-5,2.5 -9,8 -11,15 c1,2.5 5.5,2.5 7.5,0 c4,-5.5 6.5,-11.5 3.5,-15 z" />

        <!-- wings -->
        <path
            android:fillColor="#00A374"
            android:pathData="M27,58 c-7,4.5 -11.5,13.5 -10,23 c1.5,3 5,2.5 7,-0.5 c3.5,-7.5 5,-15.5 3,-22.5 z" />
        <path
            android:fillColor="#00A374"
            android:pathData="M73,58 c7,4.5 11.5,13.5 10,23 c-1.5,3 -5,2.5 -7,-0.5 c-3.5,-7.5 -5,-15.5 -3,-22.5 z" />

        <!-- body -->
        <path android:pathData="M50,27 c14,0 26,13.5 27.5,30 C79,74 66.5,88.5 50,88.5 C33.5,88.5 21,74 22.5,57 C24,40.5 36,27 50,27 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="22"
                    android:startY="27"
                    android:endX="78"
                    android:endY="88.5">
                    <item android:offset="0" android:color="#00C48C" />
                    <item android:offset="1" android:color="#4BE07A" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- highlight -->
        <group
            android:pivotX="36"
            android:pivotY="38"
            android:rotation="-35">
            <path
                android:fillColor="#FFFFFF"
                android:fillAlpha="0.25"
                android:pathData="M28.8,38 a7.2,4.6 0 1,0 14.4,0 a7.2,4.6 0 1,0 -14.4,0 z" />
        </group>

        <!-- cheeks -->
        <path
            android:fillColor="#FF5C5C"
            android:fillAlpha="0.55"
            android:pathData="M25.2,66 a5.8,4.4 0 1,0 11.6,0 a5.8,4.4 0 1,0 -11.6,0 z" />
        <path
            android:fillColor="#FF5C5C"
            android:fillAlpha="0.55"
            android:pathData="M63.2,66 a5.8,4.4 0 1,0 11.6,0 a5.8,4.4 0 1,0 -11.6,0 z" />

        <!-- eyes: счастливые дуги -->
        <path
            android:fillColor="#0F1E2E"
            android:pathData="M32,58 a6,6 0 0 1 12,0 l-2.2,0 a3.8,3.8 0 0 0 -7.6,0 z" />
        <path
            android:fillColor="#0F1E2E"
            android:pathData="M56,58 a6,6 0 0 1 12,0 l-2.2,0 a3.8,3.8 0 0 0 -7.6,0 z" />

        <!-- beak -->
        <path
            android:fillColor="#FF9F1C"
            android:pathData="M50,56.5 c4.5,1 7.5,3.5 7.5,6.5 c0,4 -4,7.5 -7.5,8.5 c-3.5,-1 -7.5,-4.5 -7.5,-8.5 c0,-3 3,-5.5 7.5,-6.5 z" />
    </group>
</vector>
