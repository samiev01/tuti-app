<?xml version="1.0" encoding="utf-8"?>
<!--
  Подложка адаптивной иконки.

  Раньше здесь оставалась стоковая зелёная сетка из шаблона Android Studio —
  она не имела отношения к бренду. Теперь это чистый градиент Jade → Leaf,
  тот же, что у тела маскота (theme/Color.kt), плюс мягкий световой блик
  сверху слева: на большинстве лаунчеров иконка лежит на светлом фоне, и
  блик отделяет её от обоев.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#FF00C48C" />
                <item android:offset="1" android:color="#FF4BE07A" />
            </gradient>
        </aapt:attr>
    </path>

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="34"
                android:centerY="30"
                android:gradientRadius="72"
                android:type="radial">
                <item android:offset="0" android:color="#33FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
