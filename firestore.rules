rules_version = '2';

// Модель данных Tuti:
//   users/{uid}                — публичный профиль: имя, город, xp, streak.
//                                Читают все авторизованные — на нём построены
//                                лидерборд и рейтинг по городам.
//   users/{uid}/sync/{docId}   — приватная синхронизация прогресса
//                                (progress, lessons, topics, words).
//                                Видит и пишет только сам владелец.

service cloud.firestore {
  match /databases/{database}/documents {

    // Администратор Tuti Admin Panel (admin.tutitj.com). Права выдаются
    // custom claim'ом через scripts/set-admin.mjs в tuti-website и из
    // клиента получены быть не могут.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /users/{userId} {
      // Читают все авторизованные, включая анонимных: на этой коллекции
      // построены лидерборд и рейтинг по городам, а они по своей природе
      // читают чужие документы.
      allow read: if request.auth != null;

      // Плюс себе не выдаётся. isPlus и plusUntil ставит только сервер,
      // поэтому клиенту запрещено и создавать документ с этими полями,
      // и менять их потом. Без этого подписку обошёл бы любой, кто
      // разберёт APK.
      allow create: if isAdmin()
                    || (request.auth != null
                        && request.auth.uid == userId
                        && !request.resource.data.keys()
                              .hasAny(['isPlus', 'plusUntil']));

      allow update: if isAdmin()
                    || (request.auth != null
                        && request.auth.uid == userId
                        && !request.resource.data.diff(resource.data)
                              .affectedKeys().hasAny(['isPlus', 'plusUntil']));

      // Профиль не удаляется из приложения вовсе: на uid завязаны
      // прогресс и место в рейтинге.
      allow delete: if false;

      // Правила родителя не наследуются подколлекциями — нужен явный match.
      match /sync/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // TUTI-PROMOCODES/{code} — промокоды Tuti Plus. Document ID и есть код.
    // Читать может любой авторизованный (иначе активация не увидит документ),
    // а из записи обычному пользователю разрешено ровно одно: погасить
    // неиспользованный код на себя. Менять active, months или чужой usedBy
    // клиент не может — это только для администратора.
    match /TUTI-PROMOCODES/{code} {
      allow read: if request.auth != null;
      allow update: if isAdmin()
                    || (request.auth != null
                        && resource.data.used == false
                        && request.resource.data.used == true
                        && request.resource.data.usedBy == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['used', 'usedBy', 'usedAt']));
      allow create, delete: if isAdmin();
    }

    // ai_reports/{id} — жалобы на ответы ИИ-репетитора. Писать может
    // любой авторизованный и только на себя: чужой userId в жалобе
    // сделал бы её бесполезной. Читать из приложения нечего — разбор
    // идёт из консоли, поэтому чтение закрыто вовсе.
    match /ai_reports/{reportId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // Всё остальное закрыто.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
